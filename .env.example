# SABI environment-variable template
# Never commit real values. Use .env.local for local secrets.
# Names below are SABI project conventions unless a provider explicitly defines them.

# SABI public backend URL (required for webhooks/custom API tools)
SABI_PUBLIC_BASE_URL=
# Shared bearer secret for bounded /api/agent-tools/* calls from BimpeAI Custom API.
# Generate a long random value and store the same value in Bimpe's bearer auth config.
SABI_AGENT_TOOL_TOKEN=

# Neon Postgres — server-side durable SABI operational storage.
# Use the connection string for the intended SABI branch/database only.
# Never expose DATABASE_URL through NEXT_PUBLIC_* or browser code.
DATABASE_URL=

# KrosAI — primary telephony transport
KROSAI_API_KEY=
# Official docs currently show both /v1 and /api/v1 examples.
# Confirm the live base/path in API Explorer before finalizing this.
KROSAI_BASE_URL=
KROSAI_PHONE_NUMBER=
KROSAI_PHONE_NUMBER_ID=
KROSAI_ENDPOINT_ID=
KROSAI_WEBHOOK_SECRET=

# BimpeAI — workflow / knowledge / bounded custom API tools
BIMPEAI_API_KEY=
BIMPEAI_BASE_URL=https://api.bimpe.ai/api/v1/console
BIMPEAI_AGENT_ID=
BIMPEAI_WORKFLOW_ID=

# Vapi — primary voice-runtime candidate behind KrosAI
# Use https://api.vapi.ai for US-hosted Vapi orgs or
# https://api.eu.vapi.ai for EU-hosted Vapi orgs. Keep API/SIP regions aligned.
VAPI_API_BASE_URL=https://api.vapi.ai
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_SIP_TRUNK_CREDENTIAL_ID=

# Retell — fallback voice runtime if Vapi is not reliable
RETELL_API_KEY=
RETELL_AGENT_ID=

# ElevenLabs — second fallback voice runtime
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# LiveKit + Spitch — optional advanced multilingual voice path
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=
LIVEKIT_SIP_TRUNK_ID=
LIVEKIT_SIP_URI=
SPITCH_API_KEY=

# YarnGPT — optional African voice enhancement
YARNGPT_API_KEY=

# Temlio
# Do not add live Temlio variables until event/API documentation confirms
# base URL, auth, request payloads and webhook contracts.
