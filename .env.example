# SABI environment-variable template
# Never commit real values. Use Vercel/secret-manager configuration for live secrets.
# Names below are SABI project conventions unless a provider explicitly defines them.

# SABI public backend URL (required for webhooks/custom API tools)
SABI_PUBLIC_BASE_URL=

# Durable mission / quote / approval / webhook idempotency storage
DATABASE_URL=

# Auth for bounded SABI agent/internal tools
SABI_AGENT_TOOL_TOKEN=

# Separate human-operator token for supervised factual evidence capture.
# Enter this token only in the operator evidence form; never expose it in client code.
SABI_OPERATOR_TOKEN=

# Communication runtime: mock | bimpe | vapi-kros
# For the real Hack Night provider-call path use vapi-kros so Bimpe orchestrates
# while Vapi + the Kros BYO SIP transport performs the actual phone call.
SABI_COMMUNICATION_MODE=mock

# Small hackathon-only optional live provider metadata directory.
# JSON array of canonical Provider fields WITHOUT phone numbers.
# Providers added through the SABI UI are persisted separately in Neon and are preferred.
SABI_LIVE_TEST_PROVIDERS_JSON=[]

# Legacy explicit consent mapping for configured metadata-only providers.
# Persisted UI-added providers keep their consented number server-side in Neon and do NOT
# require this variable. It may be left empty when all callable providers are registered.
SABI_CONSENTED_PROVIDER_PHONES_JSON={}

# BimpeAI — SABI's live orchestration brain / bounded tool runner.
# API base below is the documented Console REST API prefix.
BIMPEAI_API_KEY=
BIMPEAI_BASE_URL=https://api.bimpe.ai/api/v1/console
BIMPEAI_AGENT_ID=
BIMPEAI_WORKFLOW_ID=
# false = real webchat channel. Set true only when intentionally using Bimpe's test-channel infrastructure.
BIMPEAI_ORCHESTRATION_TEST_CHANNEL=false
# Safe default for the separate Bimpe telephony adapter. The primary SABI phone path is vapi-kros.
BIMPEAI_TEST_CALLS=true

# KrosAI — primary phone-network transport for the Hack Night live path.
KROSAI_API_KEY=
# Official docs currently show both /v1 and /api/v1 examples.
# Confirm the live base/path in API Explorer before using Kros REST directly.
KROSAI_BASE_URL=
KROSAI_PHONE_NUMBER=
KROSAI_PHONE_NUMBER_ID=
KROSAI_ENDPOINT_ID=
KROSAI_WEBHOOK_SECRET=

# Vapi — voice-agent runtime connected to the KrosAI BYO SIP trunk.
VAPI_API_BASE_URL=https://api.vapi.ai
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_SIP_TRUNK_CREDENTIAL_ID=
# Bearer token expected by POST /api/webhooks/vapi
VAPI_WEBHOOK_TOKEN=

# Retell — fallback voice runtime if needed
RETELL_API_KEY=
RETELL_AGENT_ID=

# ElevenLabs — second fallback voice runtime
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# LiveKit + Spitch — optional advanced multilingual voice path
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=
LIVEKIT_SIP_TRUNK_ID=
LIVEKIT_SIP_URI=
SPITCH_API_KEY=

# YarnGPT — optional African voice for SABI's browser intake conversation.
# The key is server-side only. Leave YARNGPT_VOICE empty to use YarnGPT's current default
# rather than hard-coding a voice ID; voice IDs may change in the live catalog.
YARNGPT_API_KEY=
YARNGPT_API_BASE_URL=https://api.yarngpt.ai
YARNGPT_VOICE=

# Temlio numbers are expected through the BimpeAI platform for Hack Night use.
# Do not add direct Temlio variables unless the platform supplies a documented direct API contract.
