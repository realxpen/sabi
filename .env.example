# SABI environment-variable template
# Never commit real values. Use .env.local for local secrets.
# Names below are SABI project conventions unless a provider explicitly defines them.

# SABI public backend URL (required for webhooks/custom API tools)
SABI_PUBLIC_BASE_URL=
# Shared bearer secret for bounded /api/agent-tools/* calls from BimpeAI Custom API.
# Generate a long random value and store the same value in Bimpe's bearer auth config.
SABI_AGENT_TOOL_TOKEN=

# Communication runtime. Defaults to mock when unset.
# Set to vapi-kros only for an explicitly authorized live-call test.
SABI_COMMUNICATION_MODE=mock
# Server-side JSON object mapping provider IDs to phone numbers whose owners have
# explicitly consented to receive live SABI test/demo calls. Example shape only:
# {"provider-id":"+234..."}
# Never commit real phone numbers.
SABI_CONSENTED_PROVIDER_PHONES_JSON=

# Messaging fallback runtime. Disabled by default.
# voicebip-temlio uses Voicebip, the API product operated by Temlio Communications.
SABI_MESSAGE_MODE=disabled
# Separate consent mapping for SMS. Call consent does not automatically grant
# message consent. Never commit real phone numbers.
SABI_CONSENTED_PROVIDER_MESSAGE_PHONES_JSON=

# African-language voice enhancement. Disabled by default because the deployed
# LiveKit Agent + SIP media path still requires external account/runtime proof.
SABI_AFRICAN_VOICE_MODE=disabled

# Neon Postgres — server-side durable SABI operational storage.
# Use the connection string for the intended SABI branch/database only.
# Never expose DATABASE_URL through NEXT_PUBLIC_* or browser code.
DATABASE_URL=

# KrosAI — primary telephony transport
KROSAI_API_KEY=
# Official docs currently show both /v1 and /api/v1 examples.
# Confirm the live base/path in API Explorer before finalizing this.
KROSAI_BASE_URL=
KROSAI_PHONE_NUMBER=
KROSAI_PHONE_NUMBER_ID=
KROSAI_ENDPOINT_ID=
KROSAI_WEBHOOK_SECRET=

# BimpeAI — workflow / knowledge / bounded custom API tools
BIMPEAI_API_KEY=
BIMPEAI_BASE_URL=https://api.bimpe.ai/api/v1/console
BIMPEAI_AGENT_ID=
BIMPEAI_WORKFLOW_ID=

# Vapi — primary voice-runtime candidate behind KrosAI
# Use https://api.vapi.ai for US-hosted Vapi orgs or
# https://api.eu.vapi.ai for EU-hosted Vapi orgs. Keep API/SIP regions aligned.
VAPI_API_BASE_URL=https://api.vapi.ai
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_SIP_TRUNK_CREDENTIAL_ID=
# Bearer token used by a saved Vapi Custom Credential for /api/webhooks/vapi.
# Store the same secret in Vapi and Vercel; never paste it into chat or commit it.
VAPI_WEBHOOK_TOKEN=

# Retell — fallback voice runtime if Vapi is not reliable
RETELL_API_KEY=
RETELL_AGENT_ID=

# ElevenLabs — second fallback voice runtime
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# LiveKit + Spitch — optional African-language voice path.
# Spitch current docs use https://api.spitch.app; keep the base configurable
# because older partner material used a different hostname.
SPITCH_API_BASE_URL=https://api.spitch.app
SPITCH_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=
LIVEKIT_SIP_TRUNK_ID=
LIVEKIT_SIP_URI=

# YarnGPT — optional African voice enhancement
YARNGPT_API_KEY=

# Voicebip / Temlio Communications — optional SMS fallback
VOICEBIP_API_BASE_URL=https://api.voicebip.com/v1
VOICEBIP_API_KEY=
VOICEBIP_AGENT_ID=
VOICEBIP_SMS_FROM_NUMBER=
# Voicebip signs webhooks as HMAC-SHA256(timestamp + "." + raw body).
VOICEBIP_WEBHOOK_SIGNING_SECRET=
# Optional old secret accepted during Voicebip's documented rotation grace window.
VOICEBIP_WEBHOOK_SIGNING_SECRET_PREVIOUS=
