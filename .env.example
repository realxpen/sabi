# SABI environment-variable template
# Never commit real values. Use Vercel/secret-manager configuration for live secrets.
# Names below are SABI project conventions unless a provider explicitly defines them.

# SABI public backend URL (required for webhooks/custom API tools)
SABI_PUBLIC_BASE_URL=

# Durable mission / quote / approval / webhook idempotency storage
DATABASE_URL=

# Auth for bounded SABI agent/internal tools
SABI_AGENT_TOOL_TOKEN=

# Separate human-operator token for supervised factual evidence capture.
# Enter this token only in the operator evidence form; never expose it in client code.
SABI_OPERATOR_TOKEN=

# Communication runtime: mock | bimpe | vapi-kros
# Keep mock until a consenting test number and the selected live transport are configured.
SABI_COMMUNICATION_MODE=mock

# Small hackathon-only live test-provider metadata directory.
# JSON array of canonical Provider fields WITHOUT phone numbers.
# Example: [{"id":"provider-perfume-test","name":"Consenting Perfume Test Provider","category":"Perfume","location":"Lagos","languages":["English"],"verified":false,"active":true}]
SABI_LIVE_TEST_PROVIDERS_JSON=[]

# Explicit consent gate for live provider calls.
# JSON object mapping provider IDs to consenting E.164 numbers, e.g. {"provider-perfume-test":"+234..."}
SABI_CONSENTED_PROVIDER_PHONES_JSON={}

# BimpeAI — primary Lagos Hack Night voice runtime + agent/workflow platform.
# API base below is the documented Console REST API prefix.
BIMPEAI_API_KEY=
BIMPEAI_BASE_URL=https://api.bimpe.ai/api/v1/console
BIMPEAI_AGENT_ID=
BIMPEAI_WORKFLOW_ID=
# Safe default: true uses BimpeAI test telephony. Set false only after live telephony is configured.
BIMPEAI_TEST_CALLS=true

# KrosAI — optional/fallback telephony transport
KROSAI_API_KEY=
# Official docs currently show both /v1 and /api/v1 examples.
# Confirm the live base/path in API Explorer before finalizing this.
KROSAI_BASE_URL=
KROSAI_PHONE_NUMBER=
KROSAI_PHONE_NUMBER_ID=
KROSAI_ENDPOINT_ID=
KROSAI_WEBHOOK_SECRET=

# Vapi — optional voice runtime behind KrosAI BYO SIP
VAPI_API_BASE_URL=https://api.vapi.ai
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_SIP_TRUNK_CREDENTIAL_ID=
# Bearer token expected by POST /api/webhooks/vapi
VAPI_WEBHOOK_TOKEN=

# Retell — fallback voice runtime if needed
RETELL_API_KEY=
RETELL_AGENT_ID=

# ElevenLabs — second fallback voice runtime
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# LiveKit + Spitch — optional advanced multilingual voice path
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=
LIVEKIT_SIP_TRUNK_ID=
LIVEKIT_SIP_URI=
SPITCH_API_KEY=

# YarnGPT — available through BimpeAI for the Hack Night; direct key only if needed separately.
YARNGPT_API_KEY=

# Temlio numbers are expected through the BimpeAI platform for Hack Night use.
# Do not add direct Temlio variables unless the platform supplies a documented direct API contract.
