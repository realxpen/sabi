# SABI environment-variable template
# Never commit real values. Use .env.local for local secrets.
# Names below are SABI project conventions unless the provider explicitly defines them.

# KrosAI — primary telephony transport
KROSAI_API_KEY=
# KrosAI public docs currently show both /v1 and /api/v1 examples.
# Confirm the live base/path in API Explorer before setting this.
KROSAI_BASE_URL=
KROSAI_PHONE_NUMBER=
KROSAI_PHONE_NUMBER_ID=
KROSAI_ENDPOINT_ID=
KROSAI_WEBHOOK_SECRET=

# BimpeAI — workflow / knowledge / custom API tools
BIMPEAI_API_KEY=
BIMPEAI_AGENT_ID=
BIMPEAI_WORKFLOW_ID=

# Vapi — primary fast voice-runtime candidate
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_SIP_TRUNK_CREDENTIAL_ID=

# LiveKit + Spitch — optional advanced multilingual voice path
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=
LIVEKIT_SIP_TRUNK_ID=
LIVEKIT_SIP_URI=
SPITCH_API_KEY=

# YarnGPT — optional African voice enhancement
YARNGPT_API_KEY=

# Temlio
# Do not add live Temlio variables until event/API documentation confirms
# authentication and request contracts.
